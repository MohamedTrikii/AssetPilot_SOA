						"key": "SOAPAction",
						"value": "\"\"",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:v1=\"http://assetpilot.com/warranty/v1\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <v1:CheckWarrantyRequest>\n         <v1:assetId>AST-001</v1:assetId>\n      </v1:CheckWarrantyRequest>\n   </soapenv:Body>\n</soapenv:Envelope>",
					"options": {
						"raw": {
							"language": "xml"
						}
