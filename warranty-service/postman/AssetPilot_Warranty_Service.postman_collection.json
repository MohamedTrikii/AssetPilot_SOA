				},
				"url": {
					"raw": "{{baseUrl}}/ws",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"ws"
					]
				},
				"description": "Vérifie la garantie d'un équipement dont la garantie est active (Dell ProSupport). isCovered doit valoir true."
			},
			"response": []
		},
