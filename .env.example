ASSET_DB_USERNAME=asset
ASSET_DB_PASSWORD=asset_pwd
WARRANTY_DB_USERNAME=warranty
WARRANTY_DB_PASSWORD=warranty_pwd
MAINTENANCE_DB_USERNAME=maintenance
MAINTENANCE_DB_PASSWORD=maintenance_pwd
